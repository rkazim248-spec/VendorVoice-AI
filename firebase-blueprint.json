{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Vendor business profile settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "businessName": { "type": "string" },
        "currency": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "gstVatNumber": { "type": "string" },
        "logoUrl": { "type": "string" },
        "language": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "businessName"]
    },
    "Customer": {
      "title": "Customer Khata Record",
      "description": "Customer contact and credit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "outstandingBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "visitCount": { "type": "number" },
        "creditRisk": { "type": "string" },
        "riskReason": { "type": "string" },
        "lastTransactionAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name"]
    },
    "Product": {
      "title": "Inventory Product",
      "description": "Stock item details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "barcode": { "type": "string" },
        "supplier": { "type": "string" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "price", "stock"]
    },
    "Transaction": {
      "title": "Ledger Transaction",
      "description": "Sale, credit, payment received, or expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "type": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "creditAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "unitPrice": { "type": "number" },
              "totalPrice": { "type": "number" }
            }
          }
        },
        "rawSpeech": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "type", "totalAmount"]
    }
  }
}
